VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Local Vite development:
# Used by vite.config.ts to proxy /api/gas directly to the Apps Script /exec endpoint.
VITE_APP_PROXY_TARGET=https://script.google.com/macros/s/your_deployment_id/exec

# Vercel local dev and Vercel production:
# Used by api/gas.ts when running through vercel dev or deployed on Vercel.
APPS_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id/exec
